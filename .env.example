# Copy these settings into your ignored .env.local. Never commit real values.
ADMIN_EMAIL=owner@example.com
# Quote passwords so characters such as # are not treated as env comments.
ADMIN_PASSWORD="replace-with-a-long-unique-password"
# Generate a real value with: openssl rand -hex 32
SESSION_SECRET="replace-with-a-random-secret-at-least-32-characters-long"
HOURS_DATA_PATH=data/walk-in-hours.json
# Enable only behind a trusted proxy that replaces X-Forwarded-For.
ADMIN_TRUST_PROXY_HEADERS=false
